{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/requests"
    },
    {
      "source": "/studio",
      "destination": "https://autocraft-studio-campus.thatanat4018.chatgpt.site/studio"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://autocraft-studio-campus.thatanat4018.chatgpt.site/admin",
      "permanent": false
    }
  ]
}